{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(git:*)",
      "Bash(gh auth *)",
      "Bash(gh pr *)",
      "Bash(fj --help)",
      "Bash(fj pr *)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(tofu version *)",
      "Bash(tofu fmt *)",
      "Bash(tofu init *)",
      "Bash(tofu validate *)",
      "Bash(brew list:*)",
      "Bash(cwebp:*)",
      "Bash(avifenc:*)",
      "Bash(fastfetch --version)",
      "Bash(tmux -V)",
      "Bash(tmux show-options *)",
      "Bash(~/.local/bin/pass-cli run *)",
      "Bash(~/.local/bin/pass-cli inject *)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:docs.hetzner.com)",
      "WebFetch(domain:letsencrypt.org)",
      "WebFetch(domain:go-acme.github.io)",
      "WebFetch(domain:protonpass.github.io)",
      "Bash(tofu plan *)",
      "Bash(echo \"exit=$?\")",
      "Bash(pnpm:*)",
      "Bash(uvx:*)",
      "Bash(gh repo *)",
      "Read(//Users/dennis/repos/**)",
      "Edit(//Users/dennis/repos/**)",
      "Write(//Users/dennis/repos/**)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)",
      "Read(//Users/*/.ssh/**)",
      "Read(//home/*/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude-chime ] && afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/dotfiles/claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "tmux-agent-sidebar@hiroppy": true
  },
  "extraKnownMarketplaces": {
    "hiroppy": {
      "source": {
        "source": "github",
        "repo": "hiroppy/tmux-agent-sidebar"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-1": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-2": {
      "autoCompactWindow": 400000
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
